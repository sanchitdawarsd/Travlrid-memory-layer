{
  "name": "email_scraper",
  "version": "1.0.0",
  "description": "Travel booking email scraper for Gmail and Outlook",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "install-all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "check": "node server/checkSetup.js",
    "setup": "npm run install-all && npm run check",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "worker": "node server/workers/emailProcessor.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "googleapis": "^128.0.0",
    "axios": "^1.6.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@azure/msal-node": "^2.4.0",
    "cheerio": "^1.0.0-rc.12",
    "nodemailer": "^6.9.7",
    "body-parser": "^1.20.2",
    "express-session": "^1.17.3",
    "openai": "^4.20.1",
    "bull": "^4.11.5",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "prisma": "^5.7.1"
  }
}
